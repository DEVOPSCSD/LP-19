# Version control
.git
.gitignore

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Pytest / Testing caches
.pytest_cache/
.coverage
htmlcov/

# Local data, logs, and backups (mounted via volumes at runtime)
data/input/*
!data/input/.gitkeep
backup/*
logs/*
*.log

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
